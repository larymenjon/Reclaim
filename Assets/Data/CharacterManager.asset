    eventName: Toque de Recolher
    eventDescription: "Impor controle total da popula\xE7\xE3o?"
  - characterName: Elara Venn
    description: "Mesmo ap\xF3s o fim, Elara acredita que a vida sempre encontra
      um caminho. Ela luta para reconstruir um mundo sustent\xE1vel."
    quote: "Se a terra ainda respira\u2026 n\xF3s tamb\xE9m podemos."
    portrait: {fileID: 0}
    specialization: 2
    passiveName: "Cultivo Sustent\xE1vel"
    passiveDescription: "Produ\xE7\xE3o de comida aumentada."
    activeName: Solo Regenerativo
    activeDescription: "Recupera \xE1reas contaminadas lentamente."
