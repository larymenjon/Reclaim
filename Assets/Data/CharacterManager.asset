    eventDescription: "Usar qu\xEDmicos para aumentar produ\xE7\xE3o?"
  - characterName: Dr. Adrian Voss
    description: "Ele j\xE1 salvou milhares. Agora, precisa escolher quem ainda vale
      a pena salvar."
    quote: "N\xE3o posso salvar todos\u2026 ent\xE3o escolho quem vive."
    portrait: {fileID: 0}
    specialization: 3
    passiveName: Triagem Rigorosa
    passiveDescription: Cura mais eficiente com menos recursos.
    activeName: "Decis\xE3o Cl\xEDnica"
