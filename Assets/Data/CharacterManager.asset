    trustBonus: 0
    eventName: Cortar Custos
    eventDescription: "Usar materiais inferiores para acelerar expans\xE3o?"
  - characterName: Marcus Hale
    description: "Veterano de guerras esquecidas, Marcus acredita que disciplina
      \xE9 a \xFAnica coisa que separa ordem do caos."
    quote: "Seguran\xE7a n\xE3o \xE9 opcional. \xC9 sobreviv\xEAncia."
    portrait: {fileID: 0}
    specialization: 1
    passiveName: Doutrina de Combate
    passiveDescription: Unidades defensivas mais eficientes.
    activeName: Lei Marcial
    activeDescription: Reduz revoltas drasticamente por um tempo.
    constructionSpeedBonus: 0
