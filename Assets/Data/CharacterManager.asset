  characters:
  - characterName: Helena Kravik
    description: "Helena era respons\xE1vel por megaprojetos antes do colapso. Hoje,
      ela reconstr\xF3i o mundo com o que sobrou \u2014 sem espa\xE7o para erros
      ou sentimentalismo."
    quote: "Estruturas n\xE3o falham. Pessoas falham."
    portrait: {fileID: 0}
    specialization: 0
    passiveName: "Efici\xEAncia Brutal"
    passiveDescription: "Constru\xE7\xF5es s\xE3o conclu\xEDdas mais r\xE1pido."
    activeName: "Improvisa\xE7\xE3o Estrutural"
    activeDescription: "Permite construir sem todos os recursos necess\xE1rios (qualidade
      reduzida)."
